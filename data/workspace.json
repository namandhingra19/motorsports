    },
    {
      "id": "f2",
      "weekId": "w_01",
      "branchId": "b_india",
      "title": "Import dependence sits in magnets, not finished motors",
      "text": "Finished motors are largely made locally, but high-grade permanent magnets are almost entirely imported. That is where both the margin and the risk sit.",
